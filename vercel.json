{
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next",
      "config": {
        "buildCommand": "npm run vercel-build",
        "outputDirectory": ".next",
        "env": {
          "DATABASE_URL": "${DATABASE_URL}"
        }
      }
    }
  ],
  "env": {
    "DATABASE_URL": "${DATABASE_URL}",
    "NODE_ENV": "production"
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    }
  ]
}
